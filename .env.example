# Wingmen Vision — Environment Variables
# Copy to .env and fill in real values before running.

# --- Supabase (Backend — uses SERVICE role key for writes) ---
# Your Supabase project URL (e.g. https://xxxxxxx.supabase.co)
SUPABASE_URL=http://localhost:54321
# Service role key (admin key, keep secret!) — get from Supabase dashboard
SUPABASE_SERVICE_KEY=supersecret-service-key-placeholder

# --- Supabase (Frontend — anon key, reads + subscriptions only) ---
# VITE_ prefix so Vite exposes it to the browser
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9-placeholder

# Backend server ---
# Port for the API server (backend/lib/live_api.ts + routes)
PORT=8081
# Base URL of the backend (used by the frontend API client)
BACKEND_BASE_URL=http://localhost:8081
